<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the code that test/run.sh generates into Generated/ from test/protos, at the lowest
    language level and API surface the generated code supports, with warnings as errors.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- At least as new as the protoc that generates the messages (PROTOC_VERSION in ci.yml) -->
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acme.Tests" />
  </ItemGroup>

</Project>
